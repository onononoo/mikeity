{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "site",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/data/(.*)\\.tsv",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/images/(.*)\\.svg",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }]
    }
  ]
}
